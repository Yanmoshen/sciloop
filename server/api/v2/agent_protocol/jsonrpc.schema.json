{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent.v2.protocol.v1/jsonrpc.schema.json",
  "title": "Agent V2 WebSocket Protocol Frame",
  "description": "线程级 WebSocket 双向会话的帧结构。三类帧由 kind 区分：request（客户端发起）、response（服务端应答某条 request）、notification（服务端主动推送，含事件通知与控制通知）。校验引擎为官方 jsonschema（server/pyproject.toml 硬依赖），禁止自研校验器。",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "kind", "id", "method"],
      "properties": {
        "contract": { "const": "agent.v2.protocol.v1" },
        "kind": { "const": "request" },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "连接内唯一的请求 id；同 id 重复提交且载荷不同即为 duplicate_request"
        },
        "method": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(/[a-z0-9_]+)+$",
          "description": "形如 thread/start、turn/start、thread/events/replay"
        },
        "params": { "type": "object" },
        "idempotency_key": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 200,
          "description": "客户端生成的幂等键；断线重试必须复用同一个键"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "data"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_request",
            "invalid_params",
            "unknown_method",
            "contract_mismatch",
            "duplicate_request",
            "stale_cursor",
            "not_subscribed",
            "runtime_unavailable",
            "shutting_down",
            "internal_error",
            "invalid_id",
            "contract_violation",
            "thread_not_found",
            "turn_not_found",
            "approval_not_found",
            "summary_not_found",
            "illegal_turn_transition",
            "concurrent_turn",
            "lease_error",
            "memory_overwrite_denied",
            "corrupted_event",
            "model_stream_error",
            "cancelled"
          ]
        },
        "message": { "type": "string" },
        "data": { "type": "object" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "kind", "id", "ok", "result", "error"],
      "properties": {
        "contract": { "const": "agent.v2.protocol.v1" },
        "kind": { "const": "response" },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ok": { "type": "boolean" },
        "result": { "type": ["object", "null"] },
        "error": {
          "oneOf": [{ "$ref": "#/$defs/error" }, { "type": "null" }],
          "description": "ok=true 时为 null；失败时必须是结构化错误对象"
        },
        "replayed": {
          "type": "boolean",
          "description": "true 表示该响应来自幂等缓存，没有产生新的副作用"
        }
      }
    },
    "notification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "kind", "method", "event_id", "sequence", "thread_id", "params"],
      "properties": {
        "contract": { "const": "agent.v2.protocol.v1" },
        "kind": { "const": "notification" },
        "method": {
          "type": "string",
          "enum": [
            "event",
            "subscription/started",
            "subscription/cancelled",
            "thread/closed",
            "server/shutting_down",
            "heartbeat",
            "protocol/error"
          ]
        },
        "event_id": { "type": "string", "pattern": "^ev_[0-9a-f]{23}$" },
        "sequence": { "type": "integer", "minimum": 0 },
        "thread_id": { "type": ["string", "null"], "pattern": "^th_[0-9a-f]{23}$" },
        "turn_id": { "type": ["string", "null"], "pattern": "^tu_[0-9a-f]{23}$" },
        "item_id": { "type": ["string", "null"], "pattern": "^it_[0-9a-f]{23}$" },
        "call_id": { "type": ["string", "null"], "pattern": "^call_[0-9a-f]{23}$" },
        "params": { "type": "object" }
      }
    },
    "frame": {
      "oneOf": [
        { "$ref": "#/$defs/request" },
        { "$ref": "#/$defs/response" },
        { "$ref": "#/$defs/notification" }
      ]
    }
  }
}
