node_modules.*/
web/dist/
web/.vite/
*.local
.vite/

# ===== 运行产物 =====
*.log
logs/
.artifacts/
artifacts/
server/.coverage
.coverage
htmlcov/

# ===== 本地缓存与临时文件 =====
.tmp/
.cache/
*.sqlite3
*.db

# ===== 重构迁移待清单（.cleanup-todo/）：改名冲突时挪进来的旧目录/垃圾，处理完可整目录删除 =====
.cleanup-todo/

# ===== 宿主侧持久化数据（容器 bind mount 的目标，禁止入库）=====
# 例：./.data/fulltext-cache —— 归一全文文本缓存，WP01 持久化后让容器重建
# 不再丢失 offset 校验所需的全文（见 docker-compose.yml 的 backend.volumes）。
.data/

# ===== 编辑器 / 系统 =====
.vscode/
.idea/
.DS_Store
Thumbs.db

# ===== AI 协作与本地工具数据（禁止入库）=====
# .learnbuddy/ 保存项目记忆（memory/）、子 agent 协调脚本、审计脚本、browser-check 截图与
# build.log，属本地隐私与过程数据，不进开源仓库。
# 注意：该目录**不是临时缓存**，只禁止入库，禁止删除本地文件。
.learnbuddy/

# ===== 第三方品牌与设计素材（禁止再分发）=====
# designlang-2026-09-18/ 是从 n8n.io 提取的品牌/设计语言素材（n8n-io-* 全套），
# wordpress-theme/ 是由它生成的衍生主题；均非本项目自有资产。
designlang-2026-09-18/
wordpress-theme/

# ===== 主办方赛事材料（禁止再分发）=====
# 仓库内唯一的 .docx 即主办方《粤港澳大湾区 AI Coding 创新大赛赛事手册》。
*.docx

# ===== 过程临时目录（验收脚手架 / 一次性脚本残留）=====
.wp11_tmp/
.*_tmp/

# ===== 一次性调试残留（下划线前缀 = 本地私有的约定）=====
# 例：scripts/verify/_dbg.err、_openapi_paths.txt —— 排查过程产生的中间产物，非交付内容。
scripts/verify/_*

# ===== 界面草稿 / 参考页面（本地文件，非交付内容）=====
# example.html：写界面时用来对照的参考页面（体积大、非本项目资产），只留本地。
example.html

# ===== 非运行必需内容（保留在本地，但永不入库）=====
# 开源仓库只保留「能跑起来的最小集合」：server/ web/ prompts/ docker-compose.yml config/
# .env.example LICENSE README.md。以下目录对运行程序不是必需的，一律不入库：
#   assets/       项目计划书、附录、任务包（含 WP01–WP17）
#   docs/         主计划、工程说明、部署手册、决策记录、运行态报告、截图
#   tests/        冒烟与集成测试
#   scripts/      开发与验证脚本（dev.sh、verify.sh、scripts/verify/*）
#   deliverables/ 视频脚本、PPT 大纲、社媒日志
#   preview/      设计稿 HTML
# 注意：gitignore 不支持行尾注释，模式必须独占一行；且只禁止入库，
# **不要删除本地文件** —— 它们仍参与本地开发与验收。
# 这些模式**必须根锚定**（前导 /）：不锚定的 `tests/` 会连
# server/services/fulltext/tests/ 这类源码内子目录一并忽略，导致源码掉出仓库。
/assets/
/docs/
/tests/
/scripts/
/deliverables/
/preview/


# ===== 本地开发专用覆盖文件（不入库）=====
# docker-compose.override.yml 把宿主源码挂进容器并开启热重载，仅供本机开发；
# 交付/生产验收请显式用 docker compose -f docker-compose.yml up -d --build 绕开它。
docker-compose.override.yml
