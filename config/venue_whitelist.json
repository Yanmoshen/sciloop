{
  "schema_version": "1.0",
  "wp": "WP04",
  "purpose": "会议/期刊 -> venue_level(0-4) 白名单。仅用于影响力辅助展示分与 venue 归一，未命中一律置 null（禁止猜测）。",
  "level_definitions": {
    "4": "领域旗舰 / CCF-A 级：顶级会议与顶级期刊",
    "3": "高水平 / CCF-B 级：主流同行评审会议与期刊",
    "2": "认可 / CCF-C 级：正规同行评审会议与期刊",
    "1": "一般同行评审：区域性会议、低影响因子期刊、出版社综合刊",
    "0": "非正式载体：预印本平台、非同行评审档案库（不能视为已发表）"
  },
  "level_rule": "4=CCF-A / 领域旗舰；3=CCF-B；2=CCF-C；1=一般同行评审；0=预印本或非同行评审载体。无法确定时不给条目，由 venue.py 返回 null。",
  "matching_notes": [
    "aliases 与 canonical 都参与归一匹配；匹配前统一小写、去标点、压缩空白",
    "带年份写法（NeurIPS 2025 / ICML'24）、届次前缀（41st / Proceedings of the）、后缀（main conference / camera-ready）由 venue.py 归一后匹配",
    "同一 venue 的 fullname / abbreviation / 带年份三种写法必须落到同一 level"
  ],
