{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "outDir": ".test-build",
    "rootDir": "../..",
    "types": []
  },
  "include": [
    "../../src/agent-v2/**/*.ts",
    "../../src/api/agent-v2.ts"
  ]
}
