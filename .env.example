# =====================================================================
# SciLoop 环境变量样例（覆盖 contracts.env_keys 全部键）
# 用法：cp .env.example .env 后填入真实值；.env 已被 .gitignore 忽略，禁止入库
# 红线：此处所有值均为占位符，禁止写入真实 API Key / OWNER_TOKEN
# =====================================================================

# ===== 应用 =====
APP_ENV=production
APP_SECRET_KEY=change_me
APP_BASE_URL=http://localhost:8080
APP_ACCESS_MODE=public_demo              # public_demo（只读）| owner_mode（可写；亦接受别名 owner）
OWNER_TOKEN=change_me                    # 仅服务端环境变量，禁止写前端包 / 数据库
PUBLIC_REPLAY_RATE_LIMIT_PER_HOUR=10

# ===== 数据库 =====
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=sciloop
POSTGRES_USER=sciloop
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://sciloop:change_me@db:5432/sciloop

# ===== 论文数据源（多源矩阵）=====
ARXIV_API_BASE=https://export.arxiv.org/api/query
ARXIV_FIELDS=cs.AI,cs.CL,cs.CV,cs.LG
SEMANTIC_SCHOLAR_API_KEY=                # 必须申请（免费）；缺失时自动降级 OpenAlex
SEMANTIC_SCHOLAR_QPS=1                   # 限流：无 key 极低，有 key 1 QPS
OPENALEX_MAILTO=your_email@example.com   # OpenAlex 友好通道，必填
OPENALEX_API_BASE=https://api.openalex.org
GITHUB_TOKEN=                            # 可选：提升代码热度查询限额
SOURCE_FETCH_TIMEOUT_SECONDS=20
SOURCE_CACHE_TTL_HOURS=24

# 排序权重（主口径：四维，合计 1.0；缺失项按剩余权重归一）
RANK_WEIGHTS={"relevance":0.40,"recency":0.25,"citation_trend":0.20,"evidence_completeness":0.15}
RECENCY_HALFLIFE_DAYS=180
# 影响力辅助分权重（仅展示，不用于默认排序；机构分与 LLM 分已退出所有计算）
INFLUENCE_WEIGHTS={"venue":0.40,"citation_velocity":0.40,"code_heat":0.20}
LLM_NOVELTY_ENABLED=1                    # 仅作辅助标签，带不确定性区间
LLM_NOVELTY_STABILITY_TOLERANCE=15       # 两次调用差 >15 分标记 unstable
VENUE_WHITELIST_FILE=config/venue_whitelist.json

# ===== 全文解析 =====
FULLTEXT_HTML_FIRST=1                    # 1 = arXiv/ar5iv HTML 优先，失败回退 PDF
FULLTEXT_PDF_PARSER=pymupdf
FULLTEXT_MIN_COVERAGE=0.60               # 低于此值只提供摘要级证据
FULLTEXT_MAX_PAGES=40
# 归一全文文本缓存目录（WP01 收尾新增，修 WP05/WP06/WP13 共同记录的 blocker）。
# 缓存里是 offset 校验用的归一全文；落容器 /tmp 时每次重建即丢，会让 paper_spans
# 的校验从 valid 退化为 valid_by_hash（前端原文高亮定位随之退化）。
# 容器内的实际取值由 docker-compose.yml 的 backend.environment 固定为
#   /app/backend/.cache/fulltext
# 并 bind mount 到宿主本目录，因此 docker compose down && up -d 后缓存仍在。
# 下面这行是「宿主侧路径」，供宿主机上直跑批量任务（python -m app.tasks.jobs.*）时使用；
# 该目录已被 .gitignore 忽略（./.data/），禁止入库。
FULLTEXT_TEXT_CACHE_DIR=./.data/fulltext-cache

# ===== 调度（APScheduler；默认关闭：演示期不自动消耗外部额度与 LLM 额度）=====
SCHEDULER_ENABLED=0                      # 1 = 在 backend 启动时注册三类批量任务
SCHEDULER_FETCH_INTERVAL_HOURS=24        # fetch_papers：多源抓取
SCHEDULER_SCORE_INTERVAL_HOURS=12        # score_papers：四维排序 + 影响力打分
SCHEDULER_PARSE_INTERVAL_HOURS=12        # parse_fulltext：全文解析与文档版本落库
SCHEDULER_JOB_LIMIT=50                   # 每轮任务的默认处理上限（防止一次跑爆额度）

# ===== LLM（默认供应商由 UI 配置，此处为兜底）=====
LLM_DEFAULT_BASE_URL=https://api.deepseek.com/v1
LLM_DEFAULT_API_KEY=
LLM_DEFAULT_MODEL=deepseek-chat
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_REPLAY=0                             # 1 = 从 demo_fixtures 回放（演示/决赛离线用）
LLM_JSON_RETRY=2

# ===== 流水线配置（默认值，可被任务书覆盖）=====
PIPELINE_MAX_ITERATIONS=3
PIPELINE_SCORE_THRESHOLD=80              # 演示 Project 单独配 72
PIPELINE_MARGINAL_GAIN_THRESHOLD=2
PIPELINE_MAX_RETRY=2
PIPELINE_MAX_LLM_COST_USD=8.0            # 成本护栏值（硬熔断线）
PIPELINE_DEMO_COST_QUOTA_USD=3.0         # 演示配额（告警线，不熔断）
PIPELINE_MAX_STAGE_MINUTES=20            # 单环节上限（须 > 单 Run 上限）

# ===== 风险策略 =====
RISK_AUTO_MAX=30
RISK_HUMAN_MAX=70
DECISION_CONFIDENCE_AUTO_MIN=0.75
DECISION_CONFIDENCE_BREAK_MIN=0.50
DECISION_REVERSIBILITY_AUTO_MIN=0.60

# ===== 实验执行器（替代 Docker 沙箱）=====
EXECUTOR_MAX_CONCURRENCY=2
EXECUTOR_RUN_TIMEOUT_SECONDS=300         # 单 Run ≤ 5 min（须 < PIPELINE_MAX_STAGE_MINUTES*60）
EXECUTOR_MAX_OUTPUT_BYTES=5242880        # 5 MB
EXECUTOR_ALLOWED_HOSTS=api.deepseek.com,api.openai.com,dashscope.aliyuncs.com
EXECUTOR_DENY_PRIVATE_NETWORK=1          # 禁止访问内网与宿主文件系统路径

# ===== Experiment Passport =====
PASSPORT_CODE_COMMIT_CMD=git rev-parse HEAD
PASSPORT_DEPENDENCY_LOCK=poetry.lock
PASSPORT_REQUIRE_COMPLETE=1              # 关键哈希缺项时 status=incomplete，不得宣称可复现

# ===== 盲评校准 =====
CALIBRATION_HUMAN_LABEL_MIN=3
CALIBRATION_METRIC=cohen_kappa
CALIBRATION_REPORT_CI=1                  # 小样本必须展示样本数，不得宣称统计显著

# ===== 演示模式 =====
DEMO_SNAPSHOT_ENABLED=1                  # 允许 ?snapshot=demo
DEMO_SEED_ON_STARTUP=0                   # 启动时导入预置示例 Project

# ===== 前端（构建期注入 Vite）=====
VITE_API_BASE=/api/v1
VITE_DEFAULT_THEME=light
